BIND_IP=127.0.0.1
WEB_PORT=8081
SPARROWFY_HOST=sparrowfy.ddns.info
TZ=America/Mexico_City
RUNTIME_STAGE=sparrowfy-dependencies
HLS_MUSIC_LAB_SQLITE_DB=/sparrowfy/database/library.sqlite
MEDIA_SOURCE=media
DATA_SOURCE=app_data
SESSION_SOURCE=sessions
BACKUP_SOURCE=backups
SPARROWFY_CRON_ENABLED=0
# Servicios propios del proyecto. Acceso de activación solo en loopback.
GENIUS_ACCESS_TOKEN=
MUSIXMATCH_API_KEY=
YT_DLP_BIN=/usr/local/bin/yt-dlp
MORNYE_LOCAL_PORT=18083
SPOTIFY_LOCAL_PORT=16080
